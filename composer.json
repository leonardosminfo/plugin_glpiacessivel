{
  "name": "leonardosminfo/glpiacessivel",
  "description": "Jornada acessivel integrada ao GLPI 10 e 11",
  "type": "glpi-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Leonardo da Silva Moreira",
      "role": "Author and maintainer"
    }
  ],
  "homepage": "https://github.com/leonardosminfo/plugin_glpi_acessivel",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "GlpiPlugin\\Glpiacessivel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GlpiPlugin\\Glpiacessivel\\Tests\\Unit\\": "tests/unit/",
      "GlpiPlugin\\Glpiacessivel\\Tests\\Integration\\": "tests/integration/"
    }
  },
  "scripts": {
    "cs": "phpcs -p --warning-severity=0",
    "cs:full": "phpcs -p",
    "stan": "phpstan analyse --memory-limit=512M",
    "test": "phpunit",
    "qa": [
      "@cs",
      "@stan",
      "@test"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
